#!/usr/bin/env bash
# macOS Bash 3.2 compatible. This launcher owns only its Compose project.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd -P)"
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-foliolet-mac}"
export FOLIOLET_INTAKE_DIR="${FOLIOLET_INTAKE_DIR:-$HOME/Downloads/Foliolet Intake}"
ACTION="${1:-up}"
status() { printf '%s %s\n' "$(date '+%H:%M:%S')" "$*"; }
fail() { printf 'Foliolet: %s\n' "$*" >&2; exit 1; }

case "$ACTION" in up|down|status|logs|test|deploy|config|help) ;; *) fail 'Use up, down, status, logs, test, deploy, config or help.' ;; esac
if [ "$ACTION" = help ]; then
  printf '%s\n' './foliolet up      Build, download missing dependencies/model, start and open Foliolet' \
    './foliolet down    Stop this Docker stack; retain documents, keys, database and models' \
    './foliolet status  Show services' './foliolet logs    Follow service logs' \
    './foliolet test    Run fictional-data acceptance checks against this stack' \
    './foliolet deploy  Pull FOLIOLET_IMAGE (immutable digest required) and start it' \
    'Run from any directory. First Docker Desktop launch may require macOS permissions/licence acceptance.'
  exit 0
fi
if ! command -v docker >/dev/null 2>&1; then
  for bin in "$HOME/.docker/bin" /Applications/Docker.app/Contents/Resources/bin "$HOME/Applications/Docker.app/Contents/Resources/bin"; do
    if [ -x "$bin/docker" ]; then export PATH="$bin:$PATH"; break; fi
  done
fi
if ! command -v docker >/dev/null 2>&1; then
  [ "$(uname -s)" = Darwin ] || fail 'Install Docker Engine with Compose v2, or Docker Desktop on macOS.'
  [ "$ACTION" = up ] || fail 'Run ./foliolet up once to install Docker Desktop.'
  bash "$ROOT/containers/install-docker-mac.sh"
  export PATH="$HOME/Applications/Docker.app/Contents/Resources/bin:$PATH"
fi
docker compose version >/dev/null || fail 'Docker Compose v2 is required. Update Docker Desktop.'
if ! docker info >/dev/null 2>&1; then
  if [ "$(uname -s)" = Darwin ] && { [ "$ACTION" = up ] || [ "$ACTION" = deploy ]; }; then
    if [ -d /Applications/Docker.app ]; then open -g /Applications/Docker.app
    elif [ -d "$HOME/Applications/Docker.app" ]; then open -g "$HOME/Applications/Docker.app"
    else fail 'Start Docker Desktop, then rerun this command.'; fi
    status 'Waiting for Docker Desktop. Complete its first-launch permissions/licence screen if shown.'
    ready=0
    for ((n=0;n<120;n++)); do
      if docker info >/dev/null 2>&1; then ready=1; break; fi
      if (( n % 5 == 0 )); then status 'Docker Desktop is starting...'; fi
      sleep 3
    done
    [ "$ready" = 1 ] || fail 'Docker did not start within six minutes. Open Docker Desktop for diagnostics, then retry.'
  else fail 'Docker is not running. Start Docker Desktop/Engine, then retry.'; fi
fi
# Avoid sending a local document vault to a remote Docker context by accident.
endpoint="${DOCKER_HOST:-$(docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null)}"
case "$endpoint" in unix://*|npipe://*) ;; *) fail 'Select a local Docker context before running Foliolet.' ;; esac
case "$FOLIOLET_INTAKE_DIR" in /*) ;; *) fail 'FOLIOLET_INTAKE_DIR must be an absolute, dedicated folder.' ;; esac
case "$FOLIOLET_INTAKE_DIR" in /|/tmp|/Users|/home|"$HOME"|"$HOME/Downloads"|"$HOME/Documents") fail 'Use a dedicated intake subfolder, not a broad personal folder.' ;; esac
# Refuse symlinks in every existing path component, including the final folder.
part="$FOLIOLET_INTAKE_DIR"
while [ "$part" != / ] && [ "$part" != . ]; do
  [ ! -L "$part" ] || fail 'Intake path must not contain symlinks.'
  part="$(dirname "$part")"
done
if [ "$ACTION" = up ] || [ "$ACTION" = deploy ]; then mkdir -p "$FOLIOLET_INTAKE_DIR"; fi
compose() { docker compose --project-directory "$ROOT" -f "$ROOT/compose.mac.yaml" -p "$COMPOSE_PROJECT_NAME" "$@"; }
run() {
  "$@" &
  child=$!
  trap 'kill "$child" 2>/dev/null || true' INT TERM
  while kill -0 "$child" 2>/dev/null; do sleep 5; if kill -0 "$child" 2>/dev/null; then status 'Working; dependency downloads and first model startup can take several minutes.'; fi; done
  code=0; wait "$child" || code=$?
  trap - INT TERM
  [ "$code" = 0 ] || { status 'Command failed. Inspect ./foliolet logs for the failed service.'; return "$code"; }
}
case "$ACTION" in
  up)
    if [ "${FOLIOLET_SKIP_BUILD:-0}" != 1 ]; then status 'Building Foliolet and running image-build regression checks...'; run compose build; fi
    status 'Starting database, EVM, local model, OCR, application and consent-based watcher...'
    run compose up -d --no-build --wait --wait-timeout 1800
    ;;
  deploy)
    case "${FOLIOLET_IMAGE:-}" in *@sha256:*) ;; *) fail 'Set FOLIOLET_IMAGE to the tested registry image@sha256:digest.' ;; esac
    run compose pull
    run compose up -d --no-build --wait --wait-timeout 1800
    ;;
  down) compose down; status 'Stopped. Persistent data and model volumes retained.'; exit 0 ;;
  status) compose ps -a; exit 0 ;;
  logs) compose logs --tail=100 -f; exit 0 ;;
  test)
    if [ "${FOLIOLET_SKIP_BUILD:-0}" != 1 ]; then run compose --profile test build test-runner; fi
    run compose --profile test run --rm --no-deps test-runner; exit 0 ;;
  config) compose config --quiet; exit 0 ;;
esac
status "Foliolet is ready: http://127.0.0.1:8008/ — intake folder: $FOLIOLET_INTAKE_DIR"
if [ "${FOLIOLET_NO_OPEN:-0}" != 1 ] && [ "$(uname -s)" = Darwin ]; then open http://127.0.0.1:8008/; fi
