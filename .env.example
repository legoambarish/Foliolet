# Full-stack Docker startup needs NO .env file: secrets and service settings are automatic.
# Optional full-stack overrides (uncomment only when needed):
# FOLIOLET_INTAKE_DIR=/Users/your-name/Downloads/Foliolet Intake
# FOLIOLET_HTTP_PORT=8008
# FOLIOLET_RPC_PORT=8548
#
# Legacy PostgreSQL-only route: docker compose -f compose.postgres.yaml up -d postgres
# Only that manual route uses POSTGRES_PASSWORD below; also set Spring's password there.
# PowerShell scripts do not source .env.
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Set these explicitly in the private Django terminal; scripts do not source .env.
# Default quick mode lazily starts one receiver-only public tunnel per checkout.
FOLIOLET_SHARE_MODE=quick
FOLIOLET_RECEIVER_PORT=8001
FOLIOLET_CONTROL_PORT=8002
FOLIOLET_TUNNEL_TIMEOUT=60
# Optional absolute path; otherwise PATH or .local-tools/cloudflared is used.
# CLOUDFLARED_PATH=C:/absolute/path/cloudflared.exe
# Already provisioned named tunnel only; route it to 127.0.0.1:8001 yourself.
# FOLIOLET_SHARE_MODE=named
# FOLIOLET_PUBLIC_BASE_URL=https://proofs.your-existing-domain.example
# Explicitly local development: FOLIOLET_SHARE_MODE=local
