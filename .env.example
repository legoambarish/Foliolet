# Optional. `docker compose up --build` uses this same public development default without .env.
# Native PowerShell scripts set their own isolated loopback development environment.
POSTGRES_PASSWORD=foliolet-public-demo-password
LOCAL_AI_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TEXT_MODEL=qwen3:4b
# Public exposure is disabled. Set only after explicit operator opt-in; never tunnel port 8000/8080.
PUBLIC_BASE_URL=
PUBLIC_EXPOSURE_OPT_IN=false
PUBLIC_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional sandbox transport. No real provider access was exercised.
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
SETU_DOCUMENT_TYPE=
SETU_ORG_ID=
SETU_DOWNLOAD_HOSTS=
# Narrow supported XML profile needs an independently provisioned certificate and scope.
IMPORT_TRUSTED_CERTIFICATE=
IMPORT_TRUSTED_ISSUER=
IMPORT_TRUSTED_TYPE=
