# Optional legacy-compatible overrides. Normally use application.yaml and environment variables.
# Copying this file to application.properties overrides YAML settings; review existing configuration first.
# Do not commit real credentials or copy a development key to a public network.
spring.datasource.url=jdbc:postgresql://127.0.0.1:55432/wallet_dev
spring.datasource.username=wallet
spring.datasource.password=
blockchain.rpc-url=http://127.0.0.1:8545
blockchain.expected-chain-id=1337
blockchain.private-key=${BLOCKCHAIN_PRIVATE_KEY}
blockchain.contract-address=${BLOCKCHAIN_CONTRACT_ADDRESS:}
blockchain.selective-contract-address=${SELECTIVE_CONTRACT_ADDRESS:}
wallet.data-dir=../.local-data
wallet.encryption-key=${WALLET_ENCRYPTION_KEY:}
wallet.share-base-url=http://localhost:8000
openrouter.api-key=${OPENROUTER_API_KEY:}
openrouter.model=inclusionai/ling-3.0-flash-vl:free
